function user_setup()
    state.OffenseMode:options('Single', 'Dual')
    state.HybridMode:options('Normal', 'PhysicalDef', 'MagicalDef')
    state.CastingMode:options('Normal', 'Resist')
    state.IdleMode:options('Single', 'DT', 'DW', 'DWDT')
  state.WeaponSet = M{
    ['description']='Weapon Set',
    'Single','SCrocea','SClub','SDagger',     -- your Single‐mode sets
    'DWSword','DWSwordCrocea','DWClubMax','DWDagger', 'Extra'  -- your Dual‐mode sets
  }


    gear.default.obi_waist = "Sekhmet Corset"
    
    select_default_macro_book()
	
    -- Set default OffenseMode and WeaponSet depending on subjob
  if player.sub_job == 'NIN' then
        -- RDM w/ NIN: allow both single & dual
        state.OffenseMode:options('Single','Dual')
        state.WeaponSet = M{
          ['description']='Weapon Set',
          'Single','SCrocea','SClub','SDagger',           -- your Single‐mode sets
          'DWSword','DWCritSword','DWSwordCrocea','DWClubMax','DWDagger', 'Enspell', 'EnspellZero', 'AdditionalEffect', 'Extra'} -- your Dual‐mode sets
      
        -- default into Dual/DW
        state.OffenseMode:set('Dual')
        state.WeaponSet:set('DWSword')
        state.IdleMode:set('DW')
    else
        -- Scholar (or any other subjob): only single‐wield
        state.OffenseMode:options('Single')
        state.WeaponSet = M{
          ['description']='Weapon Set',
          'Single','SCrocea','SClub','SDagger'
        }
        -- default into Single/Single‐idle
        state.OffenseMode:set('Single')
        state.WeaponSet:set('Single')
        state.IdleMode:set('Single')
    end

    -------------------------------------------------
    --  the rest of your setup
    -------------------------------------------------
    state.HybridMode:options('Normal','PhysicalDef','MagicalDef')
    state.CastingMode:options('Normal','Resist')
    state.IdleMode:options('Single','DT','DW','DWDT')

    gear.default.obi_waist = "Sekhmet Corset"
    select_default_macro_book()
    update_hud()
end

