if weaponSet and weaponSet.main and weaponSet.sub then
    idleSet = set_combine(idleSet, {
        main = weaponSet.main,
        sub = weaponSet.sub
    })
end
    if player.mpp < 51 and sets.latent_refresh then
        idleSet = set_combine(idleSet, sets.latent_refresh)
    end

    return idleSet
end


